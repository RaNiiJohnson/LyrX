# Convex CLI local state. `convex dev` normally writes the real value to the
# ignored .env.local file; do not commit it.
CONVEX_DEPLOYMENT=

# The auth schema generator needs non-production placeholders because it loads
# the typed Convex configuration. Runtime secrets belong in `convex env set`,
# not in this file.
BETTER_AUTH_SECRET=
SITE_URL=http://localhost:3000
